<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chariots élévateurs — QR</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b0e;color:#eef2f7;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
.wrap{max-width:760px;margin:auto;padding:16px}
.card{background:#11151b;border:1px solid #262d37;border-radius:24px;padding:20px;box-shadow:0 12px 35px rgba(0,0,0,.25)}
h1{font-size:29px;margin:0 0 5px} h2{font-size:21px;margin:25px 0 11px}
.sub,.muted{color:#9ca7b7} .badge{display:inline-block;background:#1c232d;padding:8px 14px;border-radius:999px;font-weight:750;margin:10px 0 12px}
.search,.input,.select,.textarea{width:100%;padding:13px 14px;border-radius:13px;border:1px solid #303844;background:#0c1015;color:#fff;font-size:15px}
.textarea{min-height:90px;resize:vertical}
.results{margin:8px 0} .result{padding:12px;border:1px solid #252c36;border-radius:13px;margin:7px 0;background:#0e1217;cursor:pointer}
.result small{color:#9ca7b7}
.grid{display:grid;grid-template-columns:1fr;gap:9px}.management-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.management-grid .item:last-child{grid-column:1/-1}@media(max-width:760px){.management-grid{grid-template-columns:1fr}}
.item{background:#0c1015;border:1px solid #20262f;border-radius:15px;padding:13px 15px}
.label{display:block;color:#8f9aaa;font-size:13px;margin-bottom:4px} .value{font-size:17px;font-weight:650;word-break:break-word}
.status{display:inline-block;padding:7px 11px;border-radius:999px;background:#202833;font-size:13px;font-weight:700}
button{border:0;border-radius:13px;padding:13px 16px;background:#e9eef5;color:#111;font-weight:750;font-size:15px;cursor:pointer}
button.secondary{background:#202731;color:#eef2f7}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
button.danger{background:#7f1d1d;color:#fff}
.log{border:1px solid #252c36;border-radius:15px;padding:13px;margin:9px 0;background:#0e1217}
.log b{display:block;margin-bottom:4px} .log small{color:#9ca7b7}
.hidden{display:none} footer{margin-top:22px;text-align:center;color:#737e8d;font-size:12px}
hr{border:0;border-top:1px solid #242b34;margin:22px 0}


.icon-label{display:flex;align-items:center;gap:10px;color:#f1f4f8;font-size:16px;font-weight:750;margin-bottom:7px}.field-icon{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;color:#eef2f7;flex:0 0 28px}.field-icon svg{width:25px;height:25px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.required{color:#ff3b30;margin-left:-4px}
.authbox{margin-top:10px;padding:14px;border:1px solid #303844;border-radius:15px;background:#0c1015}
.error{color:#ff8f8f;margin-top:8px;font-size:14px}
.hidden{display:none}
.multi-select{position:relative}
.multi-select-button{width:100%;padding:13px 14px;border-radius:13px;border:1px solid #303844;background:#0c1015;color:#9ca7b7;font-size:15px;text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.multi-select-button.has-selection{color:#fff}
.multi-select-arrow{font-size:17px;transition:transform .15s ease}
.multi-select.open .multi-select-arrow{transform:rotate(180deg)}
.multi-select-options{display:none;position:absolute;z-index:50;left:0;right:0;top:calc(100% + 6px);background:#111820;border:1px solid #384352;border-radius:13px;padding:6px;box-shadow:0 12px 30px rgba(0,0,0,.45)}
.multi-select.open .multi-select-options{display:block}
.multi-option{display:flex;align-items:center;gap:10px;padding:11px 10px;border-radius:9px;color:#eef2f7;cursor:pointer;font-size:15px}
.multi-option:hover{background:#1d2733}
.multi-option input{width:17px;height:17px;accent-color:#2684ff}
.multi-selected{color:#fff}
.multi-count{color:#9ca7b7;font-size:13px;margin-left:6px}
</style>
</head>
<body>
<div class="wrap"><div class="card">
<h1>Chariot élévateur</h1>
<div class="sub">Fiche technique • QR • Transformations • Gestion</div>

<label for="chariotSelect" class="label" style="margin-top:10px">Sélectionner un chariot</label>
<select id="chariotSelect" class="select"><option value="">Chargement...</option></select>
<div style="margin-top:9px"><input id="search" class="search" placeholder="" autocomplete="off"></div>
<div id="results" class="results"></div>

<div id="fiche" class="hidden">
<div id="qrid" class="badge"></div>
<div id="status"></div>

<h2>Identification</h2><div class="grid" id="identification"></div>
<h2>Caractéristiques</h2><div class="grid" id="characteristics"></div>
<h2>Informations</h2><div class="grid" id="information"></div>

<hr>
<h2>Transformation / Modification</h2>
<div id="authBox" class="authbox">
  <div id="authStatus" class="muted">Connexion requise pour enregistrer une transformation ou modification.</div>
  <form id="loginForm" onsubmit="event.preventDefault(); login();">
    <input id="loginEmail" class="input" type="email" placeholder="Email" autocomplete="username">
    <div style="margin-top:9px"><input id="loginPassword" class="input" type="password" placeholder="Mot de passe" autocomplete="current-password"></div>
    <div class="actions">
      <button onclick="login()">Se connecter</button>
      <button class="secondary" onclick="testSupabase()">Tester la connexion</button>
    </div>
    <div id="loginError" class="error"></div>
  </form>
  <div id="loggedInBox" class="hidden">
    <div id="userLabel" class="muted"></div>
    <div class="actions"><button class="secondary" onclick="logout()">Se déconnecter</button></div>
  </div>
</div>

<div id="maintenanceEditor" class="hidden">
  <div style="margin-top:12px"><input id="date" class="input" type="date"></div>
  <div style="margin-top:9px"><input id="technicien" class="input" placeholder="Technicien"></div>
  <div style="margin-top:9px">
    <div id="typeMulti" class="multi-select">
      <button type="button" id="typeMultiButton" class="multi-select-button" onclick="toggleTypeMulti()">
        <span id="typeMultiLabel">Type de modification...</span>
        <span class="multi-select-arrow">⌄</span>
      </button>
      <div id="typeMultiOptions" class="multi-select-options">
        <label class="multi-option"><input type="checkbox" value="Type de mât" onchange="updateTypeMulti()">Type de mât</label>
        <label class="multi-option"><input type="checkbox" value="Hauteur de levage" onchange="updateTypeMulti()">Hauteur de levage</label>
        <label class="multi-option"><input type="checkbox" value="Fourches" onchange="updateTypeMulti()">Fourches</label>
        <label class="multi-option"><input type="checkbox" value="Pneus" onchange="updateTypeMulti()">Pneus</label>
        <label class="multi-option"><input type="checkbox" value="Autre transformation" onchange="updateTypeMulti()">Autre transformation</label>
      </div>
    </div>
  </div>
  <div style="margin-top:9px"><textarea id="travaux" class="textarea" placeholder="Détails de la modification / nouvelle configuration / observations"></textarea></div>
  <div class="actions"><button onclick="addMaintenance()">Enregistrer la modification</button></div>
</div>

<h2>Historique</h2>
<div id="history"></div>

<div id="management" class="hidden">
<hr>
<h2>Gestion des chariots</h2>
<div class="muted" style="margin-bottom:10px">
Connecté : vous pouvez ajouter, modifier ou supprimer les données d'un chariot.
</div>

<div class="actions" style="margin-bottom:12px">
  <button onclick="newChariot()">+ Nouveau chariot</button>
  <button class="secondary" onclick="loadChariots()">Actualiser</button>
</div>

<div id="managementStatus" class="muted" style="margin-bottom:10px"></div>

<div class="grid management-grid">
  <div class="item"><span class="label">QR ID *</span><input id="m_qr_id" class="input" placeholder="CH-0082"></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M3 21V8l9-5 9 5v13"/><path d="M7 21V10h10v11M4 14h16M4 18h16"/></svg></span>Stock<span class="required">*</span></span><select id="m_stock" class="select"><option value="">Choisir un stock...</option><option>STOCK1</option><option>STOCK2</option><option>SHOWROOM</option><option>FABRICATION</option></select></div>
  <div class="item"><span class="label">N° châssis</span><input id="m_chassis" class="input"></div>
  <div class="item"><span class="label">N° de série</span><input id="m_serial_number" class="input"></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 0-4H12a2 2 0 0 1 0-4h2a7 7 0 0 0-2-10z"/><circle cx="7" cy="11" r="1"/><circle cx="9" cy="7" r="1"/><circle cx="14" cy="7" r="1"/><circle cx="17" cy="10" r="1"/></svg></span>Couleur<span class="required">*</span></span><select id="m_color" class="select"><option value="">Choisir une couleur...</option><option>Jaune</option><option>Orange</option><option>Rouge</option><option>Vert</option><option>Gris</option></select></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2.6V20a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H6v-2.6h.4a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V4h2.6v.4a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2V13h-.2a1.7 1.7 0 0 0-1.6 1z"/></svg></span>Type moteur<span class="required">*</span></span><select id="m_engine" class="select"><option value="">Choisir un type moteur...</option><option>ISUZU</option><option>MITSUBISHI</option><option>XINSHAI</option></select></div>
  <div class="item"><span class="label">N° moteur</span><input id="m_engine_number" class="input"></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 6h14M4 6l-3 7h6L4 6zM20 6l-3 7h6l-3-7zM3 17h4M17 17h4"/></svg></span>Capacité<span class="required">*</span></span><select id="m_capacity" class="select"><option value="">Choisir une capacité...</option><option>3T</option><option>3.5T</option><option>3.8T</option><option>5T</option><option>7T</option><option>10T</option></select></div>
  <div class="item"><span class="label">Hauteur de levage</span><input id="m_lifting_height" class="input" placeholder="4.5"></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M6 3v13a2 2 0 0 0 2 2h2V7M14 3v15h2a2 2 0 0 0 2-2V7M6 7h4M14 7h4M4 21h7M13 21h7"/></svg></span>Fourche<span class="required">*</span></span><select id="m_fork_dimension" class="select"><option value="">Choisir une longueur...</option><option>1,2 m</option><option>1,5 m</option><option>2 m</option><option>Autre</option></select></div>
  <div class="item"><span class="label">Type de mât</span><input id="m_mast_type" class="input" placeholder="DUPLEX / Triplex"></div>
  <div class="item"><span class="icon-label"><span class="field-icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="5" ry="9"/><path d="M12 3c2 2 3 5 3 9s-1 7-3 9M12 3c-2 2-3 5-3 9s1 7 3 9M7 7h10M7 17h10"/></svg></span>Type de pneu<span class="required">*</span></span><select id="m_tire_type" class="select"><option value="">Choisir un type de pneu...</option><option>PNEUMATIQUE</option><option>PNEU PLEIN</option></select></div>
  <div class="item"><span class="label">Statut</span><input id="m_status" class="input" placeholder="En stock"></div>
  <div class="item"><span class="label">Client</span><input id="m_client" class="input"></div>
  <div class="item"><span class="label">Date de livraison</span><input id="m_delivery_date" class="input" type="date"></div>
  <div class="item"><span class="label">Observations</span><textarea id="m_observations" class="textarea"></textarea></div>
</div>

<div class="actions">
  <button onclick="saveChariot()">Enregistrer le chariot</button>
  <button class="secondary" onclick="newChariot()">Annuler</button>
  <button class="danger" onclick="deleteChariot()">Supprimer ce chariot</button>
</div>
</div>
</div>
<footer>QR ID permanent • Données techniques et modifications stockées dans Supabase</footer>
</div></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL = "https://hkakedonludcqjgjzkei.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_AQWeYHI3Xli_1iBKVr9EPg_8L8PR-Hc";
const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);
const ADMIN_EMAIL = "HICHEMDOOOR@GMAIL.COM";

let currentUser = null;
let CHARIOTS = [];
let current = null;
let editingQrId = null;

const fields = {
  identification:[["N° châssis","N° châssis"],["N° de série","N° de serie"],["N° moteur","Engine Number"],["Moteur","Moteur"]],
  characteristics:[["Capacité","Capacité (T)"],["Hauteur de levage","Hauteur de levage (m)"],["Dimensions des fourches","Dimention de fourche (M)"],["Type de mât","Type de mât"],["Type de pneu","TYPE DE PNEU"],["Couleur","Couleur"]],
  information:[["Stock","STOCK"],["Statut","Statut"],["Client","Client"],["Date de livraison","Date livraison"],["Observations","Observations"]]
};
const esc=s=>String(s??"—").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
const params=new URLSearchParams(location.search);
const requested=params.get("id")||params.get("qr");

function friendlySupabaseError(e){
  const m=String(e?.message||e||"");
  if(/failed to fetch|networkerror|load failed|network request failed/i.test(m))
    return "Impossible de joindre Supabase. Vérifiez l'URL, la clé Publishable et la connexion Internet.";
  if(/invalid login credentials/i.test(m)) return "Email ou mot de passe incorrect.";
  if(/email not confirmed/i.test(m)) return "Email non confirmé dans Supabase Auth.";
  return m || "Erreur inconnue.";
}

function item(label,value){
  return `<div class="item"><span class="label">${esc(label)}</span><span class="value">${esc(value||"—")}</span></div>`;
}

function findChariot(q){
  if(!q) return null;
  const x=q.trim().toLowerCase();
  return CHARIOTS.find(c =>
    String(c["QR ID"]||"").toLowerCase()===x ||
    String(c["N° châssis"]||"").toLowerCase()===x
  ) || null;
}

function populateSelect(){
  const sel=document.getElementById("chariotSelect");
  sel.innerHTML='<option value="">Choisir un chariot...</option>';
  CHARIOTS.forEach(c=>{
    const opt=document.createElement("option");
    opt.value=c["QR ID"];
    opt.textContent=`${c["QR ID"]} — ${c["N° châssis"]||"Châssis non renseigné"} — ${c["Moteur"]||"Moteur non renseigné"} — ${c["Capacité (T)"]||"Capacité non renseignée"}`;
    sel.appendChild(opt);
  });
  sel.value = current ? (current["QR ID"]||"") : "";
}

async function loadChariots(){
  const box=document.getElementById("results");
  const {data,error}=await supabaseClient.from("chariots").select("*").order("qr_id",{ascending:true});
  if(error){
    console.error(error);
    box.innerHTML=`<div class="result">Erreur de chargement : ${esc(error.message)}</div>`;
    return false;
  }

  CHARIOTS=(data||[]).map(c=>({
    id:c.id,
    "STOCK":c.stock,
    "N° châssis":c.chassis,
    "N° de serie":c.serial_number,
    "Couleur":c.color,
    "Moteur":c.engine,
    "Capacité (T)":c.capacity,
    "Hauteur de levage (m)":c.lifting_height,
    "Dimention de fourche (M)":c.fork_dimension,
    "Type de mât":c.mast_type,
    "TYPE DE PNEU":c.tire_type,
    "Statut":c.status,
    "Client":c.client,
    "Date livraison":c.delivery_date,
    "Observations":c.observations,
    "Engine Number":c.engine_number,
    "QR ID":c.qr_id
  }));

  populateSelect();

  const wanted=requested || (current && current["QR ID"]);
  const wantedChariot=findChariot(wanted);
  // On the initial page, keep the selection completely empty.
  // Only open a chariot when explicitly requested/selected.
  if(wantedChariot) show(wantedChariot);

  updateManagementUI();
  return true;
}

function show(c){
  if(!c) return;
  current=c;
  document.getElementById("fiche").classList.remove("hidden");
  document.getElementById("search").value=c["QR ID"]||"";
  document.getElementById("chariotSelect").value=c["QR ID"]||"";
  document.getElementById("qrid").textContent=c["QR ID"]||"—";
  document.getElementById("status").innerHTML=`<span class="status">${esc(c["Statut"]||"Statut non renseigné")}</span>`;

  for(const section of Object.keys(fields))
    document.getElementById(section).innerHTML=fields[section].map(([l,k])=>item(l,c[k])).join("");

  if(!document.getElementById("date").value)
    document.getElementById("date").value=new Date().toISOString().slice(0,10);

  history.replaceState(null,"","?id="+encodeURIComponent(c["QR ID"]));
  editingQrId=c["QR ID"];
  fillManagementForm(c);
  renderHistory();
}

function search(q){
 const box=document.getElementById("results"),x=q.trim().toLowerCase();
 if(!x){box.innerHTML="";return}

 const found=CHARIOTS.filter(c=>{
   const qr=String(c["QR ID"]||"").toLowerCase();
   const chassis=String(c["N° châssis"]||"").toLowerCase();
   const client=String(c["Client"]||"").toLowerCase();
   return qr.includes(x) || chassis.includes(x) || client.includes(x);
 }).slice(0,12);

 box.innerHTML=found.length
   ? found.map(c=>`<div class="result" data-id="${esc(c["QR ID"])}">
       <strong>${esc(c["QR ID"])} — ${esc(c["N° châssis"]||"—")}</strong><br>
       <small>${esc(c["Client"]||"—")} • ${esc(c["Moteur"]||"—")} • ${esc(c["Statut"]||"—")}</small>
     </div>`).join("")
   : `<div class="muted" style="padding:12px">Aucun résultat trouvé.</div>`;

 box.querySelectorAll(".result").forEach(el=>el.onclick=()=>show(findChariot(el.dataset.id)));
}

async function getSession(){
  try{
    const {data,error}=await supabaseClient.auth.getSession();
    if(error) throw error;
    currentUser=data.session ? data.session.user : null;
  }catch(e){
    currentUser=null;
    document.getElementById("loginError").textContent="Supabase inaccessible : "+friendlySupabaseError(e);
  }
  updateAuthUI();
}

async function testSupabase(){
  const err=document.getElementById("loginError");
  err.textContent="Test de connexion...";
  try{
    const r=await fetch(SUPABASE_URL+"/auth/v1/settings",{headers:{apikey:SUPABASE_PUBLISHABLE_KEY}});
    const text=await r.text();
    if(!r.ok) throw new Error("HTTP "+r.status+" — "+text.slice(0,180));
    err.textContent="Connexion Supabase OK.";
  }catch(e){err.textContent="Test échoué : "+friendlySupabaseError(e);}
}

function updateAuthUI(){
  const loginForm=document.getElementById("loginForm");
  const loggedIn=document.getElementById("loggedInBox");
  const editor=document.getElementById("maintenanceEditor");
  const management=document.getElementById("management");
  const status=document.getElementById("authStatus");
  const userLabel=document.getElementById("userLabel");

  if(currentUser){
    loginForm.classList.add("hidden");
    loggedIn.classList.remove("hidden");
    editor.classList.remove("hidden");
    management.classList.remove("hidden");
    status.textContent="Connecté — modifications et gestion des chariots activées.";
    userLabel.textContent="Utilisateur : "+(currentUser.email||currentUser.id);
    const tech=document.getElementById("technicien");
    if(tech && !tech.value) tech.value=(currentUser.user_metadata?.full_name||currentUser.email||"");
  }else{
    loginForm.classList.remove("hidden");
    loggedIn.classList.add("hidden");
    editor.classList.add("hidden");
    management.classList.add("hidden");
    status.textContent="Connexion requise pour enregistrer une transformation ou modifier la base.";
    userLabel.textContent="";
  }
  updateManagementUI();
}

function updateManagementUI(){
  const s=document.getElementById("managementStatus");
  if(!s) return;
  s.textContent=editingQrId ? "Modification de : "+editingQrId : "Mode : nouveau chariot";
}


function setupLoginEnter(){
  const email=document.getElementById("loginEmail");
  const password=document.getElementById("loginPassword");
  [email,password].forEach(el=>{
    if(el) el.addEventListener("keydown",e=>{
      if(e.key==="Enter"){
        e.preventDefault();
        login();
      }
    });
  });
}

async function login(){
  const email=document.getElementById("loginEmail").value.trim();
  const password=document.getElementById("loginPassword").value;
  const err=document.getElementById("loginError");
  err.textContent="";
  if(!email||!password){err.textContent="Email et mot de passe requis.";return}
  try{
    err.textContent="Connexion...";
    const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
    if(error) throw error;
    currentUser=data.user;
    err.textContent="";
    updateAuthUI();
    await renderHistory();
  }catch(e){err.textContent=friendlySupabaseError(e);}
}

async function logout(){
  const {error}=await supabaseClient.auth.signOut();
  if(error){alert(error.message);return}
  currentUser=null;
  updateAuthUI();
  await renderHistory();
}

async function loadLogs(){
  if(!current) return [];
  const {data,error}=await supabaseClient
    .from("maintenance")
    .select("id,date,technicien,type,travaux,created_at,created_by")
    .eq("qr_id",current["QR ID"])
    .order("date",{ascending:false})
    .order("created_at",{ascending:false});
  if(error){console.error(error);return []}
  return data||[];
}

function getSelectedModificationTypes(){
  return Array.from(document.querySelectorAll("#typeMultiOptions input[type=checkbox]:checked"))
    .map(cb=>cb.value);
}

function updateTypeMulti(){
  const selected=getSelectedModificationTypes();
  const button=document.getElementById("typeMultiButton");
  const label=document.getElementById("typeMultiLabel");
  if(!button||!label) return;
  if(!selected.length){
    label.textContent="Type de modification...";
    button.classList.remove("has-selection");
  }else{
    label.textContent=selected.join(" • ");
    button.classList.add("has-selection");
  }
}

function toggleTypeMulti(){
  const box=document.getElementById("typeMulti");
  if(box) box.classList.toggle("open");
}

document.addEventListener("click",e=>{
  const box=document.getElementById("typeMulti");
  if(box && !box.contains(e.target)) box.classList.remove("open");
});

async function addMaintenance(){
  if(!current){alert("Sélectionnez un chariot.");return}
  if(!currentUser){alert("Connectez-vous pour enregistrer une modification.");return}

  const entry={
    qr_id:current["QR ID"],
    date:document.getElementById("date").value||new Date().toISOString().slice(0,10),
    technicien:document.getElementById("technicien").value.trim()||(currentUser.email||"Technicien"),
    type:getSelectedModificationTypes().join(", "),
    travaux:document.getElementById("travaux").value.trim(),
    created_by:currentUser.id
  };
  if(!entry.type&&!entry.travaux){alert("Sélectionnez au moins un type de modification et/ou indiquez les détails.");return}

  const {error}=await supabaseClient.from("maintenance").insert(entry);
  if(error){alert("Erreur : "+error.message);return}
  document.querySelectorAll("#typeMultiOptions input[type=checkbox]").forEach(cb=>cb.checked=false);
  updateTypeMulti();
  document.getElementById("travaux").value="";
  await renderHistory();
}

async function isAdmin(){
  return !!currentUser &&
    String(currentUser.email || "").toLowerCase() === ADMIN_EMAIL.toLowerCase();
}

function renderHistory(){
  const box=document.getElementById("history");
  if(!current){box.innerHTML='<div class="muted">Sélectionnez un chariot.</div>';return}
  const logs=await loadLogs();
  box.innerHTML=logs.length
    ? logs.map(x=>`<div class="log">
  <b>${esc(x.date)} — ${esc(x.type||"Intervention")}</b>
  <small>${esc(x.technicien||"Technicien non renseigné")}</small>
  <div style="margin-top:7px">${esc(x.travaux||"—")}</div>
  ${isAdmin() && x.id ? `<div class="actions"><button class="secondary" onclick="deleteMaintenance('${esc(x.id)}')">🗑️ Supprimer</button></div>` : ""}
</div>`).join("")
    : '<div class="muted">Aucune intervention enregistrée.</div>';
}

async function deleteMaintenance(id){
  if(!isAdmin()){
    alert("Suppression réservée à l'administrateur.");
    return;
  }
  if(!id) return;
  if(!confirm("Supprimer définitivement cette intervention ?\\n\\nCette action ne peut pas être annulée.")) return;

  const {error} = await supabaseClient
    .from("maintenance_history")
    .delete()
    .eq("id", id);

  if(error){
    alert("Erreur lors de la suppression : " + error.message);
    return;
  }

  await renderHistory();
}

const managementMap={
  m_qr_id:"QR ID",m_stock:"STOCK",m_chassis:"N° châssis",m_serial_number:"N° de serie",
  m_color:"Couleur",m_engine:"Moteur",m_engine_number:"Engine Number",
  m_capacity:"Capacité (T)",m_lifting_height:"Hauteur de levage (m)",
  m_fork_dimension:"Dimention de fourche (M)",m_mast_type:"Type de mât",
  m_tire_type:"TYPE DE PNEU",m_status:"Statut",m_client:"Client",
  m_delivery_date:"Date livraison",m_observations:"Observations"
};

function fillManagementForm(c){
  if(!c) return;
  for(const [id,key] of Object.entries(managementMap)){
    const el=document.getElementById(id);
    if(el) el.value=c[key]||"";
  }
  const qrInput=document.getElementById("m_qr_id");
  if(qrInput) { qrInput.readOnly=true; qrInput.title="QR ID permanent — non modifiable"; }
  editingQrId=c["QR ID"]||null;
  updateManagementUI();
}

function clearManagementForm(){
  for(const id of Object.keys(managementMap)){
    const el=document.getElementById(id);
    if(el) el.value="";
  }
  const qrInput=document.getElementById("m_qr_id");
  if(qrInput) qrInput.readOnly=false;
  editingQrId=null;
  updateManagementUI();
  document.getElementById("managementStatus").textContent="Mode : nouveau chariot";
}

async function getNextQrId(){
  const {data,error}=await supabaseClient
    .from("chariots")
    .select("qr_id")
    .not("qr_id","is",null)
    .order("qr_id",{ascending:false})
    .limit(2000);

  if(error){
    console.error(error);
    throw new Error("Impossible de déterminer le prochain QR ID : "+error.message);
  }

  const numbers=(data||[]).map(c=>{
    const m=String(c.qr_id||"").match(/^CH-(\d+)$/i);
    return m ? parseInt(m[1],10) : 0;
  }).filter(Number.isFinite);

  const next=(numbers.length ? Math.max(...numbers) : 0)+1;
  return `CH-${String(next).padStart(4,"0")}`;
}

async function newChariot(){
  if(!currentUser){alert("Connectez-vous pour gérer les chariots.");return}
  clearManagementForm();
  const qrInput=document.getElementById("m_qr_id");
  qrInput.value="";
  qrInput.readOnly=true;
  qrInput.placeholder="Génération du QR ID...";
  try {
    qrInput.value=await getNextQrId();
    qrInput.placeholder="";
  } catch(e) {
    qrInput.readOnly=true;
    qrInput.placeholder="Erreur QR ID";
    document.getElementById("managementStatus").textContent=e.message;
    return;
  }
  qrInput.title="QR ID généré automatiquement";
  document.getElementById("managementStatus").textContent="Mode : nouveau chariot — QR ID automatique";
}

function managementPayload(){
  const val=id=>document.getElementById(id).value.trim();
  const date=val("m_delivery_date");
  return {
    qr_id:val("m_qr_id"),
    stock:val("m_stock")||null,
    chassis:val("m_chassis")||null,
    serial_number:val("m_serial_number")||null,
    color:val("m_color")||null,
    engine:val("m_engine")||null,
    engine_number:val("m_engine_number")||null,
    capacity:val("m_capacity")||null,
    lifting_height:val("m_lifting_height")||null,
    fork_dimension:val("m_fork_dimension")||null,
    mast_type:val("m_mast_type")||null,
    tire_type:val("m_tire_type")||null,
    status:val("m_status")||null,
    client:val("m_client")||null,
    delivery_date:date||null,
    observations:val("m_observations")||null,
    updated_at:new Date().toISOString()
  };
}

async function saveChariot(){
  if(!currentUser){alert("Connectez-vous pour ajouter ou modifier un chariot.");return}
  const payload=managementPayload();
  if(!payload.qr_id){alert("QR ID obligatoire.");return}

  const oldQr=editingQrId;
  const status=document.getElementById("managementStatus");
  status.textContent="Enregistrement...";

  let error;
  if(oldQr){
    ({error}=await supabaseClient.from("chariots").update(payload).eq("qr_id",oldQr));
  }else{
    ({error}=await supabaseClient.from("chariots").insert(payload));
  }

  if(error){
    status.textContent="Erreur : "+error.message;
    alert("Erreur : "+error.message);
    return;
  }

  editingQrId=payload.qr_id;
  await setupLoginEnter();
loadChariots();
  const saved=findChariot(payload.qr_id);
  if(saved) show(saved);
  status.textContent="Chariot enregistré : "+payload.qr_id;
}

async function deleteChariot(){
  if(!currentUser){alert("Connectez-vous pour supprimer un chariot.");return}
  const qr=document.getElementById("m_qr_id").value.trim();
  if(!qr){alert("Sélectionnez un chariot à supprimer.");return}
  if(!confirm("Supprimer définitivement le chariot "+qr+" ?\n\nCette action ne peut pas être annulée.")) return;

  const {error}=await supabaseClient.from("chariots").delete().eq("qr_id",qr);
  if(error){alert("Erreur : "+error.message);return}

  alert("Chariot supprimé : "+qr);
  current=null;
  editingQrId=null;
  clearManagementForm();
  await loadChariots();
  if(CHARIOTS.length) show(CHARIOTS[0]);
}

document.getElementById("chariotSelect").addEventListener("change",e=>{
  if(e.target.value) show(findChariot(e.target.value));
});
document.getElementById("search").addEventListener("input",e=>search(e.target.value));

supabaseClient.auth.onAuthStateChange((event,session)=>{
  currentUser=session?session.user:null;
  updateAuthUI();
  if(current) renderHistory();
});

(async function init(){
  await getSession();
  await loadChariots();
})();
</script>
</body></html>
